{
	"name": "tournament-bracket",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 execute tournament-bracket-db --local --file=./drizzle/0000_init.sql",
		"cf:dev": "wrangler pages dev .svelte-kit/cloudflare",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare"
	},
	"dependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"drizzle-orm": "^0.44.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260724.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.114.0"
	}
}
